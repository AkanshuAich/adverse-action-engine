# Copy to .env and fill in. NEVER commit .env.

# --- Database -------------------------------------------------------------
# Local development (docker compose --profile core up -d)
# Host port 5433 avoids clashing with a locally installed PostgreSQL on 5432.
AAE_DATABASE_URL=postgresql+psycopg://aae_app:aae_dev_password@localhost:5433/aae
AAE_MIGRATION_DATABASE_URL=postgresql+psycopg://aae_owner:aae_dev_password@localhost:5433/aae
# Production: Neon connection string (requires sslmode=require)
# AAE_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST.neon.tech/aae?sslmode=require

# --- LLM providers --------------------------------------------------------
# One of: cerebras | groq | ollama
#
# Groq, not Cerebras. Cerebras withdrew its free tier during this project and
# now answers 402 for every model; the key still authenticates, which is why
# the failure reads as a model problem rather than a billing one. Groq remains
# free at 14,400 requests/day with no card: https://console.groq.com/keys
#
# Confirm the model name against a live listing before pinning it. A model that
# has been renamed fails exactly like a bad credential, and these names change:
#   GET https://api.groq.com/openai/v1/models  (Authorization: Bearer <key>)
AAE_LLM_PROVIDER=groq
AAE_LLM_MODEL=openai/gpt-oss-120b

# https://cloud.cerebras.ai  (free tier, no card)
AAE_CEREBRAS_API_KEY=
# https://console.groq.com   (free tier, no card)
AAE_GROQ_API_KEY=
# Local fallback: ollama serve
AAE_OLLAMA_BASE_URL=http://localhost:11434

# --- Behaviour ------------------------------------------------------------
AAE_ENV=development
AAE_LOG_LEVEL=INFO
AAE_JURISDICTION=india_rbi
# 0.15, not 0.5. The naive classification cut declines far fewer applicants
# than actually default on an imbalanced target, and would mean the notice
# pipeline almost never fires.
AAE_DECISION_THRESHOLD=0.15
AAE_TOP_K_FACTORS=5
AAE_MAX_REPAIR_ATTEMPTS=3
