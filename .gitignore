# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/

# Secrets - never commit
.env
*.pem
*.key

# Data and artifacts - too large for git, reproducible from scripts.
# Leading slash anchors these to the repository root. Without it, `data/`
# also matched src/aae/data/ and silently excluded the entire data package
# from the repository.
/data/
/mlruns/
/artifacts/
*.onnx
*.csv
!evals/golden/*.csv

# Local tooling
.DS_Store
.idea/
.vscode/
