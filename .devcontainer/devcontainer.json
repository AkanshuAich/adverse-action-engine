{
  "name": "Adverse Action Engine",
  // 3.12, not the 3.11 the Streamlit template ships. The package uses a PEP 695
  // `type` statement, which is a syntax error before 3.12, and pyproject.toml
  // declares requires-python = ">=3.12".
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "customizations": {
    "codespaces": {
      "openFiles": [
        "README.md",
        "deploy/streamlit/app.py"
      ]
    },
    "vscode": {
      "settings": {},
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff"
      ]
    }
  },
  // The template looked for a root requirements.txt, which this project does
  // not have and should not: dependencies live in pyproject.toml. Without this
  // the Codespace installed streamlit alone and the app failed on `import aae`.
  "updateContentCommand": "pip3 install --user -e '.[console,dev]' && echo 'Package installed in editable mode.'",
  "postAttachCommand": {
    "server": "streamlit run deploy/streamlit/app.py --server.enableCORS false --server.enableXsrfProtection false"
  },
  "portsAttributes": {
    "8501": {
      "label": "Review console",
      "onAutoForward": "openPreview"
    }
  },
  "forwardPorts": [
    8501
  ]
}
